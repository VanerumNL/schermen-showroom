{
  "name": "schermen-showroom",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/media/*", "/s/*"] },
  "kv_namespaces": [{ "binding": "KV", "id": "05c361f4095f468bbc181136e5870919" }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true }
}
