{
  "name": "schermen-showroom",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/media/*", "/s/*", "/k/*", "/t/*", "/", "/index.html", "/aanraakscherm*", "/startschermen*", "/uitloggen", "/login"] },
  /* het workers.dev-adres blijft aan: dat staat in AbleSign en op de touchscreens */
  "workers_dev": true,
  /* de editors op het eigen adres, achter de centrale inlog van account.vanerumnederland.nl */
  "routes": [
    { "pattern": "schermen.vanerumnederland.nl", "custom_domain": true },
    /* startscherm Isselwaerde op een eigen adres (EIGEN_ADRES in src/worker.js) */
    { "pattern": "isselwaerde.vanerumnederland.nl", "custom_domain": true },
    /* aanraakscherm NOT-stand op een eigen adres */
    { "pattern": "not.vanerumnederland.nl", "custom_domain": true }
  ],
  /* het centrale accountsysteem is de Worker "kaartenmaker" */
  "services": [{ "binding": "ACCOUNT", "service": "vanerum-portaal" }],
  "kv_namespaces": [{ "binding": "KV", "id": "05c361f4095f468bbc181136e5870919" }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true },
  /* elk kwartier controleren of de tv's in AbleSign online zijn (src/ablesign.js) */
  "triggers": { "crons": ["*/15 * * * *"] },
  /* previews (andere branches dan main) krijgen een eigen, lege KV-opslag */
  "previews": {
    "kv_namespaces": [{ "binding": "KV", "id": "8fb995a401f34d5fa62618938c7710e8" }],
    "version_metadata": { "binding": "CF_VERSION_METADATA" }
  }
}
